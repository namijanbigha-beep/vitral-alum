# Copy to ops/.env and fill in. Never commit the real file.
APP_ENV=production              # production | staging
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://vitral:change-me@db:5432/vitral
SESSION_SECRET=                 # openssl rand -base64 48
FILE_STORAGE_DIR=/data/files
BACKUP_DIR=/backups
BACKUP_ENCRYPTION_KEY=          # openssl rand -base64 48 ; keep a copy outside the server
APP_ORIGIN=https://vitral.example.com
DOMAIN=vitral.example.com       # Caddy obtains the certificate for this name
COOKIE_SECURE=true
# Phase 5
TELEGRAM_BOT_TOKEN=
BOT_INTERNAL_API_URL=http://app:3000
BOT_SERVICE_KEY=
