# Copy to ops/.env and fill in. Never commit the real file.
APP_ENV=production              # production | staging
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://vitral:change-me@db:5432/vitral
SESSION_SECRET=                 # openssl rand -base64 48
FILE_STORAGE_DIR=/data/files
BACKUP_DIR=/backups
BACKUP_ENCRYPTION_KEY=          # openssl rand -base64 48 ; keep a copy outside the server
APP_ORIGIN=https://vitral.example.com
DOMAIN=vitral.example.com       # Caddy obtains the certificate for this name
COOKIE_SECURE=true
PUBLIC_URL=https://vitral.example.com   # used in guest links and bot messages
DAILY_REPORT_TIME=21:00                 # Tehran time; nightly snapshot + Telegram report to managers
# CHROMIUM_PATH=/usr/bin/chromium       # PDF renderer (set in the image; override only for a custom build)
# Telegram bot (apps/bot) — leave TELEGRAM_BOT_TOKEN empty to run without the bot
TELEGRAM_BOT_TOKEN=
BOT_SERVICE_KEY=                        # openssl rand -base64 48 ; shared by app and bot
ALERT_POLL_SECONDS=30
